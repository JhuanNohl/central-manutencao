# Homologação: uma só origem para o portal e a API, como exige o cookie de
# sessão. SITE_ADDRESS é o APP_ORIGIN da API, ex.: https://192.168.0.10:8443.
{
	# Rede interna, sem domínio público: certificado da CA local do Caddy.
	auto_https disable_redirects
	# Acesso pelo IP não envia o nome do servidor (SNI) no TLS.
	default_sni {$SITE_HOST}

	# Conexões lentas de propósito (slowloris) não seguram o servidor.
	servers {
		timeouts {
			read_header 10s
			read_body 5m
			write 5m
			idle 2m
		}
	}
}

{$SITE_ADDRESS} {
	tls internal
	import /etc/caddy/site.caddy
}

# Servidor (docker-compose.producao.yml). Copie para docker/producao.env, fora
# do git, e preencha no deploy. Campos vazios são obrigatórios: sem eles, o
# compose ou a API recusam subir e dizem o que falta.

# ---------- Endereço público ----------
# Domínio do portal, sem https://. A API só aceita requisições desta origem.
APP_DOMAIN=central.empresa.com.br

# ---------- Traefik (já em execução no servidor) ----------
# Rede, entrada HTTPS e emissor de certificado do Traefik. Veja os valores
# usados pelos outros serviços em docs/deploy-servidor.md.
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=

# ---------- Banco (contêiner postgres, sem porta publicada) ----------
# Senha longa e aleatória, ex.: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------- API ----------
NODE_ENV=production
COOKIE_SECURE=true
# Proxies à frente da API: Traefik e Caddy.
TRUST_PROXY_HOPS=2
OPERATIONAL_TIMEZONE=America/Sao_Paulo
RMA_SLA_HOURS=720

# E-mail real do setor (ex.: porta 465 com SMTP_SECURE=true, ou 587 com false).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Central de Manutenção <manutencao@empresa.com.br>"
# Caixa do setor: recebe todos os avisos da equipe.
MAINTENANCE_INBOX_EMAIL=manutencao@empresa.com.br

# CNPJ da fábrica, destinatário obrigatório nas notas de remessa (só dígitos).
INVOICE_RECIPIENT_DOCUMENT=

# Cloudflare Turnstile (anti-robô): as chaves do widget criado para o domínio
# no painel da Cloudflare. A secreta nunca vai para o navegador nem para o git.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Texto do termo de garantia que o cliente aceita no portal
# (apps/api/legal/termo-garantia.json, copiado para o servidor fora do git).
WARRANTY_TERMS_FILE=legal/termo-garantia.json
FILES_STORAGE_DIR=storage/files

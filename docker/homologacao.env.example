# Homologação interna em contêineres. Copie para docker/homologacao.env
# (fora do git) e ajuste. Os valores abaixo são exemplos.

# ---------- Acesso ----------
# Endereço único do portal, igual para o computador e o celular na rede interna:
# https://APP_HOST:HTTPS_PORT. A API só aceita requisições desta origem.
APP_HOST=192.168.0.10
HTTPS_PORT=8443

# ---------- Banco (contêiner postgres) ----------
POSTGRES_PASSWORD=troque-por-uma-senha-longa
# Porta local (127.0.0.1) para importar os dados do sistema atual.
POSTGRES_PORT=5434
MAILPIT_PORT=8026

# ---------- API (mesmas regras de produção) ----------
NODE_ENV=production
COOKIE_SECURE=true
# O Caddy fica à frente da API.
TRUST_PROXY_HOPS=1
OPERATIONAL_TIMEZONE=America/Sao_Paulo
RMA_SLA_HOURS=720

# E-mail: por padrão vai para o Mailpit da homologação. Para enviar de verdade,
# use o servidor do setor (ex.: porta 465 com SMTP_SECURE=true) e a senha da conta.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Manutenção <manutencao@empresa.com.br>"
MAINTENANCE_INBOX_EMAIL=manutencao@empresa.com.br

# CNPJ da fábrica, destinatário obrigatório nas notas de remessa (só dígitos).
INVOICE_RECIPIENT_DOCUMENT=
# Endereço da fábrica no destinatário da nota: "logradouro; número; bairro;
# município; UF". Divergência deixa a documentação pendente, sem barrar a abertura.
INVOICE_RECIPIENT_ADDRESS="Rua das Palmeiras; 100; Centro; Cidade Exemplo; SP"

# Cloudflare Turnstile (anti-robô) no cadastro e na redefinição de
# senha. Obrigatório em produção. As chaves abaixo são as de TESTE da Cloudflare
# (sempre aprovam); no servidor, use as do painel da Cloudflare para o domínio.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Termo de garantia da empresa (apps/api/legal/termo-garantia.json, montado no contêiner).
WARRANTY_TERMS_FILE=legal/termo-garantia.json
FILES_STORAGE_DIR=storage/files

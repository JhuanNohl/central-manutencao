# Copie para apps/api/.env e ajuste. Nunca versione o .env real.
NODE_ENV=development
API_PORT=3000
# Proxies reversos confiáveis à frente da API (1 atrás do Traefik).
TRUST_PROXY_HOPS=0

DATABASE_URL=postgres://central:central@localhost:5433/central

# Origem pública do frontend (usada em links de e-mail e na verificação de Origin).
APP_ORIGIN=http://localhost:5173

# Cookie de sessão: em produção, COOKIE_SECURE=true (HTTPS obrigatório).
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# Tentativas por minuto e por IP em login, cadastro e links enviados por e-mail.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Fuso operacional para exibição de datas (instantes são persistidos em UTC).
OPERATIONAL_TIMEZONE=America/Sao_Paulo

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Central de Manutenção <nao-responda@central.local>"

# Processador de notificações (fila durável no PostgreSQL).
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_POLL_SECONDS=5
NOTIFICATIONS_MAX_ATTEMPTS=5
